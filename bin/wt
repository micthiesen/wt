#!/bin/sh
# wt-native-compat-v1

# Keep the historical ~/.wt/bin/wt entry point working after this checkout's
# TypeScript runtime is retired. This wrapper only forwards to an installed
# native launcher; it never downloads or builds wt itself.
if [ -z "${HOME:-}" ]; then
  echo "wt: HOME is unset; install or configure the native launcher first" >&2
  exit 127
fi

install_root=${WT_INSTALL_ROOT:-"$HOME/.local/share/wt"}
stable_launcher=$install_root/bin/wt

if [ ! -x "$stable_launcher" ]; then
  echo "wt: native launcher not found at $stable_launcher" >&2
  echo "Install it with:" >&2
  echo "  curl -fsSL https://github.com/micthiesen/wt/releases/latest/download/install.sh | sh -s -- --path" >&2
  exit 127
fi

# A bad WT_INSTALL_ROOT can point back at this compatibility wrapper. Refuse
# that configuration rather than recursively execing ourselves.
if [ "$stable_launcher" -ef "$0" ]; then
  echo "wt: WT_INSTALL_ROOT resolves to this compatibility wrapper; set it to the native install root or reinstall wt" >&2
  exit 126
fi

exec "$stable_launcher" "$@"
